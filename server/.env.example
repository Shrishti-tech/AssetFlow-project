PORT=5000
# Local MongoDB: mongodb://127.0.0.1:27017/assetflow
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/assetflow
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
NODE_ENV=development
